# =============================================================================
# WhatsApp <-> Vercel Bridge - environment variables
# Copy to .env for local runs. On Render/Railway set these in the dashboard.
# =============================================================================

# --- Server -------------------------------------------------------------------
# Glitch, Render and Railway inject PORT at runtime. Only set it for local runs (falls back to 3000).
PORT=3000

# --- Supabase (auth state storage) ---------------------------------------------
# Project Settings > API. Use the SERVICE ROLE key (never the anon key) and
# never expose it to browser or Vercel client-side code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Vercel webhook (inbound: WhatsApp -> Vercel) -------------------------------
VERCEL_WEBHOOK_URL=https://cr-agent.vercel.app/api/webhook/baileys

# --- Shared secret --------------------------------------------------------------
# Sent as `x-bridge-secret` to Vercel, and required on POST /send-message.
# Use the SAME value in your Vercel project's environment variables.
# Generate one with:  openssl rand -hex 32
BRIDGE_SECRET=change-me-to-a-long-random-string

# --- Optional: sessions & logging ------------------------------------------------
# SESSION_ID=default            # letters/digits/hyphens; one id per WhatsApp number
# LOG_LEVEL=info                # pino level for this app
# BAILEYS_LOG_LEVEL=warn        # pino level for Baileys internals (use debug to troubleshoot)

# --- Optional: outbound anti-ban rate limiting -----------------------------------
# MAX_PENDING_PER_JID=3         # queued + in-flight messages allowed per recipient (extra -> HTTP 429)
# MIN_GAP_PER_JID_MS=2000       # extra pause between two sends to the same chat
# MAX_MESSAGES_PER_MINUTE=20    # global outbound ceiling (extra -> HTTP 429)

# --- Optional: webhook & keep-alive ----------------------------------------------
# WEBHOOK_TIMEOUT_MS=25000      # how long to wait for Vercel to answer the webhook
# Self-ping every 3 minutes to stop free containers idling. The target is auto-detected from:
#   RENDER_EXTERNAL_URL  (set by Render)   -> <url>/health
#   PROJECT_DOMAIN       (set by Glitch)   -> https://<PROJECT_DOMAIN>.glitch.me/health
# Set KEEP_ALIVE_URL to override (e.g. a Railway public domain):
# KEEP_ALIVE_URL=https://your-service.up.railway.app/health
